{
  "name": "lens-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:browser": "playwright test",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "prisma migrate deploy",
    "maintenance": "tsx scripts/maintenance.ts",
    "account:delete": "tsx scripts/delete-account.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run test:browser && npm run build && npm run scan:secrets",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@xyflow/react": "^12.11.6",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.27.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
